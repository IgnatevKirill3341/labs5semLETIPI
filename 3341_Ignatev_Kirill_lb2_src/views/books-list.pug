extends layout

block content
  .books-page
    .page-header
      h2
        i.fas.fa-book-open
        |  Список книг
      button.btn.btn-primary#addBookBtn
        i.fas.fa-plus
        |  Добавить книгу
    
    .filters
      .filter-group
        label(for='filterSelect')
          i.fas.fa-filter
          |  Фильтр:
        select#filterSelect
          option(value='all') Все книги
          option(value='available') В наличии
          option(value='borrowed') Выдано
          option(value='overdue') Просрочен возврат
    
    .books-grid#booksGrid
      each book in books
        .book-card(data-id=book.id)
          if book.coverImage
            .book-cover
              img(src=book.coverImage, alt=book.title)
          else
            .book-cover.placeholder
              i.fas.fa-book
          .book-info
            h3.book-title= book.title
            p.book-author
              i.fas.fa-user-edit
              |  #{book.author}
            p.book-release
              i.fas.fa-calendar
              |  #{book.releaseDate}
            .book-status
              if book.isAvailable
                span.status-badge.available
                  i.fas.fa-check-circle
                  |  В наличии
              else
                span.status-badge.borrowed
                  i.fas.fa-exclamation-circle
                  |  Выдана
                if book.returnDate
                  - const today = new Date().toISOString().split('T')[0]
                  - const isOverdue = book.returnDate < today
                  p.borrower-info(class=isOverdue ? 'overdue' : '')
                    i.fas.fa-user
                    |  #{book.borrowedBy}
                    br
                    i.fas.fa-clock
                    |  Вернуть до: #{book.returnDate}
                    if isOverdue
                      span.overdue-badge
                        i.fas.fa-exclamation-triangle
                        |  Просрочено
          .book-actions
            a.btn.btn-sm.btn-primary(href=`/books/${book.id}`)
              i.fas.fa-eye
              |  Открыть
            button.btn.btn-sm.btn-danger.delete-book(data-id=book.id, data-title=book.title)
              i.fas.fa-trash
              |  Удалить

    // Add Book Modal
    dialog#addBookModal
      .modal-content
        .modal-header
          h3
            i.fas.fa-plus-circle
            |  Добавить книгу
          button.modal-close#closeAddModal
            i.fas.fa-times
        .modal-body
          form#addBookForm
            .form-group
              label(for='addTitle')
                i.fas.fa-book
                |  Название *
              input#addTitle(type='text', name='title', required)
            .form-group
              label(for='addAuthor')
                i.fas.fa-user-edit
                |  Автор *
              input#addAuthor(type='text', name='author', required)
            .form-group
              label(for='addReleaseDate')
                i.fas.fa-calendar
                |  Дата выпуска *
              input#addReleaseDate(type='date', name='releaseDate', required, max='')
            .modal-actions
              button.btn.btn-secondary(type='button', onclick='document.getElementById("addBookModal").close()')
                i.fas.fa-times
                |  Отмена
              button.btn.btn-primary(type='submit')
                i.fas.fa-save
                |  Сохранить

    // Delete Confirmation Modal
    dialog#deleteModal
      .modal-content
        .modal-header
          h3
            i.fas.fa-exclamation-triangle
            |  Подтверждение удаления
          button.modal-close#closeDeleteModal
            i.fas.fa-times
        .modal-body
          p Вы уверены, что хотите удалить книгу 
            strong#deleteBookTitle
            | ?
        .modal-actions
          button.btn.btn-secondary#cancelDelete
            i.fas.fa-times
            |  Отмена
          button.btn.btn-danger#confirmDelete
            i.fas.fa-trash
            |  Удалить

block scripts
  script(src='/js/books-list.js')
